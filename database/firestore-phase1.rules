rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath());
    }

    function profile() {
      return get(userPath()).data;
    }

    function active() {
      return hasProfile() && profile().active == true;
    }

    function role(roleName) {
      return active() && profile().role == roleName;
    }

    function admin() { return role("ADMIN"); }
    function hospital() { return role("HOSPITAL"); }
    function driver() { return role("DRIVER"); }
    function patient() { return role("PATIENT"); }
    function staff() { return admin() || hospital(); }

    function ownDriver(driverId) {
      return driver() && profile().driverId == driverId;
    }

    function assignedToCurrentDriver() {
      return driver() && resource.data.assignedDriver == profile().driverId;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update, delete: if admin();
    }

    match /alerts/{alertId} {
      // Live patient, hospital and driver listeners need read access after sign-in.
      allow read: if signedIn();

      // Normal emergency and one-tap SOS.
      allow create: if signedIn();

      // Hospital/admin manages the case. The assigned driver can update trip state.
      allow update: if staff() || assignedToCurrentDriver();
      allow delete: if staff();
    }

    match /drivers/{driverId} {
      // Hospital assignment list and Driver 1/2/3 demo switcher.
      allow read: if signedIn();
      allow create, delete: if staff();
      allow update: if staff() || ownDriver(driverId);
    }

    match /patients/{patientId} {
      allow read, create, update: if staff();
      allow delete: if admin();
    }

    match /bills/{billId} {
      allow read, create, update: if staff();
      allow delete: if admin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create: if staff() || driver();
      allow update, delete: if staff();
    }

    match /loginAudit/{auditId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
